# Copy to .env and adjust. Every setting is optional; defaults live in src/docchat/config.py.
DOCCHAT_OLLAMA_HOST=http://localhost:11434
DOCCHAT_LLM_MODEL=qwen3.5:4b
# DOCCHAT_LLM_MODEL=gemma4:e4b
# Empty = reuse DOCCHAT_LLM_MODEL (qwen3.5 and gemma4 are both vision-capable)
DOCCHAT_VISION_MODEL=
DOCCHAT_EMBED_MODEL=bge-m3
DOCCHAT_NUM_CTX=16384
DOCCHAT_THINK=false

# Empty = embedded Qdrant under data/qdrant (single process). For Docker: http://localhost:6333
DOCCHAT_QDRANT_URL=

# pymupdf | docling | marker | unstructured
DOCCHAT_PDF_PARSER=pymupdf
# rapidocr | tesseract | paddleocr
DOCCHAT_OCR_BACKEND=rapidocr

# Answering: fast | balanced | deep (deep = thinking mode + revision)
DOCCHAT_ANSWER_MODE=balanced
# Describe images with the vision model at upload (slower ingest, searchable charts)
DOCCHAT_CAPTION_IMAGES=true

# Reranker: fastembed (CPU, ONNX) | sentence-transformers (GPU; `uv sync --extra rerank-gpu --extra cuda`) | none
DOCCHAT_RERANKER_BACKEND=fastembed
DOCCHAT_RERANKER_MODEL=BAAI/bge-reranker-base
# GPU machine suggestion:
# DOCCHAT_RERANKER_BACKEND=sentence-transformers
# DOCCHAT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Concurrent Ollama requests from parallel agents (match OLLAMA_NUM_PARALLEL on the server)
DOCCHAT_LLM_PARALLEL=2
